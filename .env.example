# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Vercel / Production Environment Variables:
# ADMIN_USERNAME="Marat"
# ADMIN_PASSWORD="your_admin_password"
# SESSION_SECRET="random-long-secret-string"
# TELEGRAM_BOT_TOKEN="1234567890:ABCdef..."
# TELEGRAM_CHAT_ID="987654321"

# Optional Upstash Redis / Vercel KV REST credentials for permanent database persistence on Vercel:
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
